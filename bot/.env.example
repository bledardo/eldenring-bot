# --- Required ---
DISCORD_TOKEN=your_discord_bot_token
ADMIN_USER_ID=your_discord_user_id
NOTIFICATION_CHANNEL_ID=discord_channel_id

# --- Currency (Runes) ---
CURRENCY_NAME=Runes
CURRENCY_SYMBOL=🪙
STARTING_BALANCE=5000
# Runes credited to the player when they kill any boss
BOSS_KILL_REWARD=200

# --- Betting cycles (Elden Ring fights) ---
BET_WINDOW_MINUTES=5
LINKED_PLAYER_BET_WINDOW_MINUTES=2
SOLO_BET_BONUS_PERCENT=25
BONUS_ALL_WINNERS_PERCENT=10
PLAYER_CUT_PERCENT=10
PLAYER_BASE_REWARD=100
SEED_POOL=500
BOOKMAKER_MARGIN_PERCENT=5
MAX_MINORITY_BONUS_PERCENT=50
STREAK_BONUS_PERCENT=20
STREAK_THRESHOLD=3
DEFAULT_WINRATE_PERCENT=50

# --- Elden Ring Watcher API ---
ER_API_PORT=3000
ER_PUBLIC_HOST=

# --- Feature flags (default on except where noted) ---
FEATURE_TRACKING_ELDEN_RING=true
FEATURE_BETTING_ELDEN_RING=true
FEATURE_GIVEAWAYS=true
FEATURE_GOLDEN_OFFER=true
FEATURE_SPONTANEOUS_BETS=true
FEATURE_FIRST_BETTOR_BONUS=true
FEATURE_BET_MODIFICATION=false

# --- LLM (optional, requires Ollama) ---
LLM_ENABLED=false
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=mistral:7b
LLM_DEFAULT_MODE=normal
LLM_DEFAULT_CONTEXT=complet
LLM_BOT_NAME=Tarnished
LLM_PERSONALITY=un compagnon des Terres Intermédiaires, sarcastique mais respectueux, qui chambre les Sans-éclat
LLM_RESPONSE_STYLE=Phrases courtes et percutantes. Références Souls/Elden Ring assumées.
FEATURE_LLM_COMMENTS=true
FEATURE_LLM_MENTIONS=true

DEBUG=false
